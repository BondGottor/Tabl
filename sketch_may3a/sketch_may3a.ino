// Буфер для текущего кадра в RAM
RGB currentFrame[MATRIX_HEIGHT][MATRIX_WIDTH];

int themeIndex = 0;
bool variant = false;

unsigned long lastVariantChange = 0;
unsigned long lastThemeChange = 0;

// Преобразование координат в индекс (змейка)
int getIndex(int x, int y) {
  if (y % 2 == 0) {
    return y * MATRIX_WIDTH + x;
  } else {
    return y * MATRIX_WIDTH + (MATRIX_WIDTH - 1 - x);
  }
}

// Загрузка темы из PROGMEM в RAM
void loadTheme(int index, bool var) {
  const RGB (*source)[MATRIX_WIDTH];
  
  switch(index) {
    case 0: source = var ? molotok2 : molotok1; break;
    case 1: source = var ? pivo2 : pivo1; break;
    case 2: source = var ? medved2 : medved1; break;
    case 3: source = var ? raketa2 : raketa1; break;
    default: source = molotok1;
  }
  
  // Копируем из PROGMEM в RAM
  for (int y = 0; y < MATRIX_HEIGHT; y++) {
    for (int x = 0; x < MATRIX_WIDTH; x++) {
      memcpy_P(&currentFrame[y][x], &source[y][x], sizeof(RGB));
    }
  }
}

// Вывод на ленту
void displayFrame() {
  for (int y = 0; y < MATRIX_HEIGHT; y++) {
    for (int x = 0; x < MATRIX_WIDTH; x++) {
      int index = getIndex(x, y);
      RGB rgb = currentFrame[y][x];
      strip.setPixelColor(index, strip.Color(rgb.r, rgb.g, rgb.b));
    }
  }
  strip.show();
}

void setup() {
  strip.begin();
  strip.setBrightness(BRIGHTNESS);
  strip.show();
  
  loadTheme(themeIndex, variant);
  displayFrame();
  
  lastVariantChange = millis();
  lastThemeChange = millis();
}

void loop() {
  unsigned long now = millis();
  
  if (now - lastVariantChange >= 400) {
    variant = !variant;
    loadTheme(themeIndex, variant);
    displayFrame();
    lastVariantChange = now;
  }
  
  if (now - lastThemeChange >= 10000) {
    themeIndex = (themeIndex + 1) % 4;
    variant = false;
    loadTheme(themeIndex, variant);
    displayFrame();
    lastThemeChange = now;
    lastVariantChange = now;
  }
}